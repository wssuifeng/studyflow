        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Status"
      },
      "cursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cursor"
      },
      "limit": {
        "default": 50,
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "history": {
        "default": false,
        "title": "History",
        "type": "boolean"
      }
    },
    "title": "QueueRequest",
    "type": "object"
  },
  "assignment.context": {
    "additionalProperties": false,
    "properties": {
      "submission_ids": {
        "items": {
          "type": "string"
        },
        "maxItems": 100,
        "minItems": 1,
