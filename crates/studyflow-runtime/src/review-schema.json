        "type": "array"
      }
    },
    "required": [
      "submission_ids"
    ],
    "title": "ContextRequest",
    "type": "object"
  },
  "review.write": {
    "$defs": {
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "quote": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "location": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Location",
            "type": "string"
          },
          "reason": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "guidance": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Guidance",
            "type": "string"
          },
          "next_action": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Next Action",
            "type": "string"
          }
        },
        "required": [
          "quote",
          "location",
          "reason",
          "guidance",
          "next_action"
        ],
        "title": "Issue",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "submission_id": {
        "minLength": 1,
        "title": "Submission Id",
        "type": "string"
      },
      "summary": {
        "minLength": 1,
        "title": "Summary",
        "type": "string"
      },
      "detail_markdown": {
        "default": "",
        "title": "Detail Markdown",
        "type": "string"
      },
      "issue_count": {
        "default": 0,
        "minimum": 0,
        "title": "Issue Count",
        "type": "integer"
      },
      "needs_revision": {
        "default": false,
        "title": "Needs Revision",
        "type": "boolean"
      },
      "idempotency_key": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Idempotency Key"
      },
      "source": {
        "default": "AGENT_CLI",
        "title": "Source",
        "type": "string"
      },
      "decision": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Decision"
      },
      "next_action": {
        "default": "",
        "title": "Next Action",
        "type": "string"
      },
      "issues": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/Issue"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Issues"
      },
      "reference_hash": {
        "anyOf": [
          {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reference Hash"
      },
      "reference_revision": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reference Revision"
      },
      "reference_reason": {
        "default": "",
        "maxLength": 3000,
        "title": "Reference Reason",
        "type": "string"
      }
    },
    "required": [
      "submission_id",
      "summary"
    ],
    "title": "ReviewRequest",
    "type": "object"
  },
