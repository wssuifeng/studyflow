# Copy to .env only on your own machine; never commit secrets.
STUDYFLOW_WORKSPACE=
# Desktop/local default: the application manages this SQLite file automatically.
STUDYFLOW_DATABASE_URL=sqlite:///./studyflow.db
# Optional development/server mode (use a dedicated least-privilege account):
# STUDYFLOW_DATABASE_URL=mysql+pymysql://studyflow_app:CHANGE_ME@127.0.0.1:3306/studyflow
STUDYFLOW_HOST=127.0.0.1
STUDYFLOW_PORT=8787
