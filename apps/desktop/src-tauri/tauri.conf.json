{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyFlow",
  "version": "1.8.18",
  "identifier": "local.studyflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StudyFlow · 学习控制台",
        "width": 1440,
        "height": 920,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' https://dict.youdao.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "binaries/studyflow-engine.exe",
      "binaries/studyflow.exe",
      "binaries/studyflow-agent/"
    ],
    "publisher": "wssuifeng",
    "windows": {
      "wix": {
        "upgradeCode": "abffc78e-4655-5ca9-b66b-386907ab5fee",
        "fragmentPaths": [
          "wix/upgrade-compatibility.wxs"
        ],
        "componentGroupRefs": [
          "StudyFlowUpgradeCompatibility"
        ]
      }
    }
  }
}
